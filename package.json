{
  "name": "sosis",
  "version": "0.1.0",
  "description": "Local-first, agent-native App Store Connect MCP server.",
  "keywords": [
    "app-store-connect",
    "mcp",
    "ai-agents",
    "ios",
    "indie-dev",
    "testflight"
  ],
  "license": "MIT",
  "private": false,
  "scripts": {
    "sosis": "node --import tsx scripts/cli.ts",
    "mcp": "node --import tsx mcp/server.ts",
    "mcp:doctor": "node --import tsx scripts/mcp-doctor.ts",
    "test": "node --import tsx --test src/lib/core/*.test.ts src/lib/storage/*.test.ts src/lib/server/*.test.ts",
    "lint": "eslint",
    "uninstall": "tsx scripts/uninstall-launchd.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "jsonwebtoken": "^9.0.3",
    "p-queue": "^9.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "eslint": "^9",
    "tsx": "^4.22.1",
    "typescript": "^5",
    "typescript-eslint": "^8.46.0"
  }
}
